{
  "modelPresets": {
    "local": {
      "model": "ollama/qwen3:8b",
      "provider": "ollama",
      "maxTokens": 8192,
      "contextWindowTokens": 32768,
      "temperature": 0.2,
      "reasoningEffort": "high"
    },
    "localBig": {
      "model": "ollama/qwen3:32b",
      "provider": "ollama",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "temperature": 0.2,
      "reasoningEffort": "high"
    }
  },

  "agents": {
    "defaults": {
      "modelPreset": "local",
      "fallbackModels": [],
      "maxToolIterations": 400,
      "maxConcurrentSubagents": 4,
      "maxToolResultChars": 40000,
      "providerRetryMode": "persistent",
      "reasoningEffort": "high",
      "temperature": 0.2,
      "idleCompactAfterMinutes": 30,
      "botName": "Nanobot von Alex via Arena.ai",
      "botIcon": "\ud83d\udc08",
      "dream": {
        "enabled": true,
        "intervalH": 1
      }
    }
  },

  "tools": {
    "web": {
      "enable": true,
      "search": {
        "provider": "duckduckgo",
        "maxResults": 10,
        "timeout": 45
      },
      "fetch": {
        "useJinaReader": true
      }
    },
    "exec": {
      "enable": true,
      "timeout": 300
    },
    "file": {
      "enable": true
    },
    "cliApps": {
      "enable": false
    },
    "my": {
      "enable": false,
      "allowSet": false
    },
    "imageGeneration": {
      "enabled": false
    },
    "restrictToWorkspace": false
  },

  "channels": {
    "sendProgress": true,
    "sendToolHints": true,
    "showReasoning": true
  }
}
